{
  "name": "mobilemoneybridge-relayer",
  "version": "0.1.0",
  "description": "Node.js middleware that listens to mobile money webhooks and triggers Soroban smart contract settlements",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --passWithNoTests",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'"
  },
  "keywords": ["stellar", "soroban", "mpesa", "mtn-momo", "airtel-money", "blockchain"],
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "12.3.0",
    "express": "4.19.2",
    "dotenv": "16.4.5"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "20.14.2",
    "@typescript-eslint/eslint-plugin": "7.13.0",
    "@typescript-eslint/parser": "7.13.0",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "ts-jest": "29.1.5",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  }
}
